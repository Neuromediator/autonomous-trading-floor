# LLM providers. OPENAI_API_KEY is required; the rest only matter with USE_MANY_MODELS=true.
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GOOGLE_API_KEY=
GROK_API_KEY=
OPENROUTER_API_KEY=

# Market data. Optional: without a key, prices come from a deterministic simulator.
MASSIVE_API_KEY=

# Web search for the researcher agent.
TAVILY_API_KEY=

# Push notifications (pushover.net). Optional.
PUSHOVER_USER=
PUSHOVER_TOKEN=

# Trading floor engine.
RUN_EVERY_N_MINUTES=60
RUN_EVEN_WHEN_MARKET_IS_CLOSED=false
USE_MANY_MODELS=false
