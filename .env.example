# LLM providers. With USE_MANY_MODELS=true (the default) one trader runs on
# OpenAI directly and the rest, with the sub-agents, go through OpenRouter, so
# OPENAI_API_KEY and OPENROUTER_API_KEY are both needed. With
# USE_MANY_MODELS=false everyone runs on one OpenAI model, which also needs
# SUB_AGENT_MODEL=gpt-5.6-luna so the sub-agents stay on OpenAI too.
# The keys below are optional: a model name without a "/" that mentions the
# provider routes to it directly instead of through OpenRouter.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=
GROK_API_KEY=

# The Researcher and RiskManager run on one cheap model for every trader: they
# do most of the token volume, and sharing it keeps the traders comparable.
SUB_AGENT_MODEL=deepseek/deepseek-v4-flash

# Market data (massive.com). Required: there is no simulated fallback.
MASSIVE_API_KEY=

# Web search for the researcher agent. Searches are cached in the database and
# capped per run, which keeps four traders a day inside the free 1000/month.
TAVILY_API_KEY=
MAX_SEARCHES_PER_RUN=10
SEARCH_CACHE_TTL_SECONDS=21600

# Push notifications (pushover.net). Off by default: the traders' summaries only
# go to the activity log unless PUSH_NOTIFICATIONS=true and both keys are set.
PUSH_NOTIFICATIONS=false
PUSHOVER_USER=
PUSHOVER_TOKEN=

# Trading floor engine. Traders run one after another with a pause between them,
# every RUN_EVERY_N_MINUTES (set 1440 for once a day).
RUN_EVERY_N_MINUTES=60
SECONDS_BETWEEN_TRADERS=60
RUN_EVEN_WHEN_MARKET_IS_CLOSED=false
USE_MANY_MODELS=true

# Traces upload to OpenAI's dashboard, authorised with OPENAI_API_KEY even when
# no trader runs on an OpenAI model. Set false to keep them local; the
# dashboard's activity log is written by our own tracer either way.
OPENAI_TRACING=true
