# Copy to .env and fill in the keys. This file is shaped for production: one
# trading round a day, every day. Anything the engine can default is commented
# out below — uncomment a line only to change it.
#
# Never leave a variable set to an empty value. An empty string still lands in
# the environment and overrides the built-in default; commenting the line out
# is what falls back to it.

# --- LLM providers (required) ------------------------------------------------
# The four traders run one model each. Warren goes to OpenAI directly, so his
# raw requests show up in the platform's Responses log; the other three and both
# sub-agents go through OpenRouter (a "/" in the model name routes there). Both
# keys are needed. OPENAI_API_KEY also authorises the trace upload.
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# --- Data (required) ---------------------------------------------------------
# Market data (massive.com). There is no simulated fallback; the engine refuses
# to start without it. The free tier is enough.
MASSIVE_API_KEY=

# Web search for the Researcher. Searches are cached in the database and capped
# per round, which keeps four traders a day inside the free 1000/month.
TAVILY_API_KEY=

# --- Schedule ----------------------------------------------------------------
# One round a day at this UTC time. US market hours are 13:30-20:00 UTC in
# summer and 14:30-21:00 in winter, so anything from 15:00 to 19:00 stays
# inside them all year.
RUN_AT=15:00

# Run the round on weekends and market holidays too, instead of skipping it.
# Costly: it takes the month from ~22 rounds to ~30, and the search budget below
# is sized for the trading calendar.
RUN_EVEN_WHEN_MARKET_IS_CLOSED=false

# --- Optional ----------------------------------------------------------------
# Shown with their built-in defaults; uncomment one to change it.

# Push notifications (pushover.net). Off by default: the traders' summaries only
# reach the activity log unless this is true and both keys are set.
#PUSH_NOTIFICATIONS=false
#PUSHOVER_USER=
#PUSHOVER_TOKEN=

# Traces upload to OpenAI's dashboard. Set false to keep them local; the
# dashboard's own activity log is written by our tracer either way.
#OPENAI_TRACING=true

# Pause between traders inside a round. They run one after another, not in
# parallel, so four agents don't burst through LLM and market-data rate limits.
#SECONDS_BETWEEN_TRADERS=60

# Housekeeping, applied when the engine starts. Trace logs and cached searches
# expire; accounts, strategies and the agents' memory are never pruned. Set
# either to 0 to keep everything.
#LOG_RETENTION_DAYS=90
#SEARCH_RETENTION_DAYS=7

# The Researcher's search budget per round, and how long a cached result stays
# fresh (seconds).
#MAX_SEARCHES_PER_RUN=12
#SEARCH_CACHE_TTL_SECONDS=21600

# Where the database lives. Defaults to accounts.db beside the code, which is
# also right under systemd — the unit files set WorkingDirectory but the path
# is resolved from the source file, not the working directory.
#DB_PATH=

# --- Local testing -----------------------------------------------------------
# Comment RUN_AT out and the engine runs a round immediately, then every
# RUN_EVERY_N_MINUTES. This is for testing only; it does not hold its place in
# the day. USE_MANY_MODELS=false puts all four traders on one cheap OpenAI
# model, which also needs SUB_AGENT_MODEL=gpt-5.6-luna to keep the sub-agents
# on OpenAI.
#RUN_EVERY_N_MINUTES=60
#USE_MANY_MODELS=true
#SUB_AGENT_MODEL=deepseek/deepseek-v4-flash
