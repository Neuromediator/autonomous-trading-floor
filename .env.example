# LLM providers. With USE_MANY_MODELS=true (the default) the four traders run on
# OpenAI plus Grok, Gemini and DeepSeek through OpenRouter, so OPENAI_API_KEY and
# OPENROUTER_API_KEY are needed. With USE_MANY_MODELS=false only OPENAI_API_KEY
# is used. The keys below are optional: a model name without a "/" that mentions
# the provider routes to it directly instead of through OpenRouter.
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=
GROK_API_KEY=

# Market data (massive.com). Required: there is no simulated fallback.
MASSIVE_API_KEY=

# Web search for the researcher agent.
TAVILY_API_KEY=

# Push notifications (pushover.net). Off by default: the traders' summaries only
# go to the activity log unless PUSH_NOTIFICATIONS=true and both keys are set.
PUSH_NOTIFICATIONS=false
PUSHOVER_USER=
PUSHOVER_TOKEN=

# Trading floor engine. Traders run one after another with a pause between them,
# every RUN_EVERY_N_MINUTES (set 1440 for once a day).
RUN_EVERY_N_MINUTES=60
SECONDS_BETWEEN_TRADERS=60
RUN_EVEN_WHEN_MARKET_IS_CLOSED=false
USE_MANY_MODELS=true
